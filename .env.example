# Copy these into your environment (Windows: set VAR=value / setx VAR=value)
# Required for broadcasting:
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Your admin channel/group/user numeric chat id (negative for groups/channels):
TG_CHAT_ID=-100123456789
# Optional: extra broadcast recipients (comma separated) - normally managed
# automatically via /subscribe in subscribers.json:
TG_SUBSCRIBERS=